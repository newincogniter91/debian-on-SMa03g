#!/bin/sh
# USB network (RNDIS gadget) with a fixed static IP: phone 192.168.7.2/24, PC 192.168.7.1/24
IP=192.168.7.2/24
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
G=/sys/kernel/config/usb_gadget/g1

if [ ! -d "$G/functions/rndis.usb0" ]; then
  mkdir -p "$G" && cd "$G" || exit 1
  echo 0x1d6b > idVendor
  echo 0x0104 > idProduct
  mkdir -p strings/0x409
  echo Debian > strings/0x409/manufacturer
  echo debian-a03 > strings/0x409/product
  echo 0001 > strings/0x409/serialnumber
  mkdir -p configs/c.1/strings/0x409
  echo rndis > configs/c.1/strings/0x409/configuration
  mkdir -p functions/rndis.usb0
  echo 1 > os_desc/use
  echo 0xcd > os_desc/b_vendor_code
  echo MSFT100 > os_desc/qw_sign
  echo RNDIS > functions/rndis.usb0/os_desc/interface.rndis/compatible_id
  echo 5162001 > functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id
  ln -s "$G/functions/rndis.usb0" "$G/configs/c.1/"
  ln -s "$G/configs/c.1" "$G/os_desc/"
fi

# wait for the USB device controller (max 60 s)
i=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ "$i" -lt 60 ]; do sleep 1; i=$((i+1)); done
UDC=$(ls /sys/class/udc | head -n1)
[ -n "$UDC" ] || { echo "no UDC found"; exit 1; }
[ -z "$(cat "$G/UDC" 2>/dev/null)" ] && echo "$UDC" > "$G/UDC"

# wait for the interface (usb0 or rndis0) and assign the fixed IP
i=0
IF=""
while [ -z "$IF" ] && [ "$i" -lt 30 ]; do
  for n in usb0 rndis0; do [ -d "/sys/class/net/$n" ] && IF=$n; done
  [ -n "$IF" ] || { sleep 1; i=$((i+1)); }
done
[ -n "$IF" ] || { echo "USB interface did not appear"; exit 1; }
ip addr flush dev "$IF"
ip addr add "$IP" dev "$IF"
ip link set "$IF" up
echo "USB $IF on $UDC with $IP"
